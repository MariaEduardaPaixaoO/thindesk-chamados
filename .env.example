# Copie este arquivo para .env e preencha os valores.
# Não use aspas nos valores.

# Conexão com o MongoDB (local ou Atlas)
MONGODB_URI=mongodb://localhost:27017
# MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=thindesk

PORT=8080

# Usuário de demonstração
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# Cria a carga inicial de dados quando as coleções estão vazias
SEED_DEMO_DATA=true
